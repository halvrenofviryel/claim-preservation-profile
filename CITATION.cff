  - Apache-2.0
license-url: "https://creativecommons.org/licenses/by/4.0/legalcode"
keywords:
  - claim preservation
  - evidence contract
  - AI assurance
  - observer effect
  - probe effect
  - measurement semantics
  - conformance
authors:
  - family-names: "Abak"
    given-names: "Ali Toygar"
    affiliation: "Phionyx"
references:
  - type: article
    title: >-
      Access Is Not Yet Verifiability: Toward a Claim-Preserving Evidence Contract
      for AI Assurance
    authors:
      - family-names: "Abak"
        given-names: "Ali Toygar"
        affiliation: "Phionyx"
    notes: >-
      Position paper providing the conceptual motivation for this profile. It is
      not normative specification text.
