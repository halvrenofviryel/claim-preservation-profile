{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/halvrenofviryel/claim-preservation-profile/raw/main/source-capsule/schema/claim-capsule.schema.json",
  "title": "CPP Source Capsule Claim Capsule",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "capsule_id",
    "capsule_version",
    "created_at",
    "claim",
    "subject",
    "evaluation_contract",
    "source",
    "source_binding",
    "mapping_loss",
    "selection",
    "measurement",
    "assessment",
    "scope"
  ],
  "properties": {
    "capsule_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "capsule_version": {"const": "0.3"},
    "created_at": {"type": "string"},
    "claim": {
      "type": "object",
      "required": ["id", "text"],
      "properties": {"id": {"type": "string"}, "text": {"type": "string"}}
    },
    "subject": {
      "type": "object",
      "required": ["id", "revision"],
      "properties": {"id": {"type": "string"}, "revision": {"type": "string"}}
    },
    "evaluation_contract": {
      "type": "object",
      "required": ["id", "revision", "criterion"],
      "properties": {
        "id": {"type": "string"},
        "revision": {"type": "string"},
        "criterion": {
          "type": "object",
          "required": ["operator", "threshold"],
          "properties": {
            "operator": {"enum": ["gte", "gt", "lte", "lt", "eq"]},
            "threshold": {"type": "number"}
          }
        }
      }
    },
    "source": {
      "type": "object",
      "required": ["format", "ref", "sha256", "adapter_version"],
      "properties": {
        "format": {"enum": ["inspect-ai-v2", "promptfoo-jsonl"]},
        "ref": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "adapter_version": {"type": "string"}
      }
    },
    "source_binding": {
      "type": "object",
      "required": ["subject_revision"],
      "properties": {
        "subject_revision": {
          "type": "object",
          "required": ["observed", "value", "source_path"],
          "properties": {
            "observed": {"type": "boolean"},
            "value": {"type": ["string", "null"]},
            "source_path": {"type": ["string", "null"]}
          }
        }
      }
    },
    "mapping_loss": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coverage", "declared", "admitted", "omitted", "unavailable"],
      "properties": {
        "coverage": {"const": "DECLARED_SELECTED_FIELDS"},
        "declared": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["declared_path", "target_path"],
            "properties": {
              "declared_path": {"type": "string", "minLength": 1},
              "target_path": {"type": "string", "minLength": 1}
            }
          }
        },
        "admitted": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source_paths", "target_path", "transform"],
            "properties": {
              "source_paths": {
                "type": "array",
                "minItems": 1,
                "items": {"type": "string", "minLength": 1}
              },
              "target_path": {"type": "string", "minLength": 1},
              "transform": {"type": "string", "minLength": 1}
            }
          }
        },
        "omitted": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source_path", "reason"],
            "properties": {
              "source_path": {"type": "string", "minLength": 1},
              "reason": {"type": "string", "minLength": 1}
            }
          }
        },
        "unavailable": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["target_path", "reason"],
            "properties": {
              "target_path": {"type": "string", "minLength": 1},
              "reason": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "selection": {"type": "object"},
    "measurement": {
      "type": "object",
      "required": ["state", "complete", "processing_complete"],
      "allOf": [
        {
          "if": {"properties": {"complete": {"const": true}}, "required": ["complete"]},
          "then": {
            "properties": {
              "state": {"const": "OBSERVED"},
              "processing_complete": {"const": true}
            }
          }
        },
        {
          "if": {"properties": {"state": {"const": "ERROR"}}, "required": ["state"]},
          "then": {
            "properties": {
              "complete": {"const": false},
              "processing_complete": {"const": false}
            }
          }
        },
        {
          "if": {"properties": {"state": {"const": "NOT_MEASURED"}}, "required": ["state"]},
          "then": {"properties": {"complete": {"const": false}}}
        }
      ],
      "properties": {
        "state": {"enum": ["OBSERVED", "NOT_MEASURED", "ERROR"]},
        "complete": {"type": "boolean"},
        "processing_complete": {"type": "boolean"},
        "value": {"type": "number"},
        "unit": {"type": "string"},
        "population": {"type": "object"},
        "reason": {"type": "string"}
      }
    },
    "assessment": {
      "type": "object",
      "required": ["evidence_finding", "applicability", "processing", "basis", "qualifications"],
      "properties": {
        "evidence_finding": {"enum": ["SUPPORTED", "REFUTED", "NOT_MEASURED", "INCONCLUSIVE"]},
        "applicability": {"enum": ["CURRENT", "STALE", "UNKNOWN"]},
        "processing": {"enum": ["COMPLETED", "ERROR"]},
        "basis": {
          "type": "object",
          "required": ["evidence_finding", "applicability", "processing"],
          "properties": {
            "evidence_finding": {"type": "string"},
            "applicability": {"type": "string"},
            "processing": {"type": "string"}
          }
        },
        "qualifications": {"type": "array", "items": {"type": "string"}}
      }
    },
    "scope": {"type": "object"}
  }
}
